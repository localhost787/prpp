# Copy to .env (git-ignored) or set in Vercel. Never commit admin credentials, client secrets or tokens.
# Everything EXPO_PUBLIC_* is visible in the public bundle: synthetic demo accounts only, never admin credentials.
EXPO_PUBLIC_DATA_MODE=live
EXPO_PUBLIC_MEDPLUM_BASE_URL=https://medplum.example.test/
EXPO_PUBLIC_MEDPLUM_PROJECT_ID=<project-id>
EXPO_PUBLIC_BOT_COMPARTIR_ID=
# One-click demo accounts. These users and passwords are SIMULATED: fictional people with synthetic
# data, not admin accounts, published on purpose so anyone can run the demo. Leave empty to hide the buttons.
EXPO_PUBLIC_DEMO_CARMEN_EMAIL=carmen@example.com
EXPO_PUBLIC_DEMO_CARMEN_PASSWORD=ePUupeeRSpY9VtJwZrdW
EXPO_PUBLIC_DEMO_LOURDES_EMAIL=lourdes@example.com
EXPO_PUBLIC_DEMO_LOURDES_PASSWORD=gsDjMOUA5LbdQk65TVMy
