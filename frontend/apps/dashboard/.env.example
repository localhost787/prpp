# Copy to .env (git-ignored) or set in Vercel. Placeholders only: never commit real values.
# Everything EXPO_PUBLIC_* is visible in the public bundle (see docs/CONEXION-LIVE.md).
EXPO_PUBLIC_DATA_MODE=live
EXPO_PUBLIC_MEDPLUM_BASE_URL=https://medplum.example.test/
EXPO_PUBLIC_MEDPLUM_PROJECT_ID=<project-id>
EXPO_PUBLIC_BOT_COMPARTIR_ID=
# Optional one-click demo accounts (team decision). Leave empty to hide the buttons.
EXPO_PUBLIC_DEMO_CARMEN_EMAIL=
EXPO_PUBLIC_DEMO_CARMEN_PASSWORD=
EXPO_PUBLIC_DEMO_LOURDES_EMAIL=
EXPO_PUBLIC_DEMO_LOURDES_PASSWORD=
EXPO_PUBLIC_DEMO_RAFAEL_EMAIL=
EXPO_PUBLIC_DEMO_RAFAEL_PASSWORD=
